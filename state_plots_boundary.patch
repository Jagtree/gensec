+class _StubSolver:
+    """Solver that never converges, optionally with the pure-axial fields."""
+
+    def __init__(self, **extra):
+        self._extra = extra
+
+    def solve_equilibrium(self, N, Mx, My):
+        sol = {"converged": False, "iterations": 50}
+        sol.update(self._extra)
+        return sol
+
+
+def test_no_state_anywhere_is_reported_not_swallowed(rig, tmp_path):
+    """
+    Nothing at the demand and nothing at the boundary: kind ``"none"``.
+
+    No file, a message that names both failures, and the solver's own
+    ``reason`` / ``refusal`` passed through verbatim.
+    """
+    section, _, dom, demands, _ = rig
+    stub = _StubSolver(reason="axial_state_not_attainable",
+                       refusal="N is outside the reach [a, b]")
+    recs = export_demand_state_plots(section, stub, dom, demands,
+                                     {"BAD0"}, str(tmp_path))
+    r, = recs
+    assert r["kind"] == "none" and r["files"] == []
+    assert r["eta_ray"] is not None and r["eta_ray"] > 1.0
+    assert "either" in r["message"]
+    assert "axial_state_not_attainable: N is outside the reach" \
+        in r["message"]
+    assert os.listdir(tmp_path) == []
+
+
+def test_undefined_boundary_point_is_reported_not_swallowed(rig, tmp_path):
+    """The hull refuses (origin outside): the refusal is the message."""
+    section, _, _, demands, _ = rig
+
+    class _Refusing:
+        def is_inside(self, *a):
+            return False
+
+        def boundary_point_along_ray(self, *a):
+            raise ValueError("origin is not inside the resistance hull")
+
+    recs = export_demand_state_plots(section, _StubSolver(), _Refusing(),
+                                     demands, {"BAD0"}, str(tmp_path))
+    r, = recs
+    assert r["kind"] == "none" and r["eta_ray"] is None
+    assert "boundary point undefined" in r["message"]
+    assert "origin is not inside" in r["message"]
+    assert os.listdir(tmp_path) == []
+
