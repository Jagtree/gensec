+# ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+# FITNESS FOR A PARTICULAR PURPOSE.  See the GNU Affero General Public
+# License for more details.
+#
+# You should have received a copy of the GNU Affero General Public License
+# along with GenSec.  If not, see <https://www.gnu.org/licenses/>.
+# ---------------------------------------------------------------------------
+r"""
+``gensec run`` no longer ends without a ``state_*.png``, and never silently.
+
+The defect, as measured
+-----------------------
+``gensec run`` selects the ``fiber_details_top_k`` demands with the
+highest governing :math:`\eta` and then solves for the strain plane at
+each.  A demand outside the resistance domain has no such plane, and it
+ranks first.  With :math:`k` or more of them the selection held no
+demand that could be plotted: measured on a section with one verified
+demand and five outside it, ``state_*.png`` count **0**, and one line
+``SOLVER DID NOT CONVERGE`` per demand.
+
+What is asserted
+----------------
+1. The geometric primitive (:math:`\mathbf{R} = \mathbf{T}/\eta`) on a
+   hull whose exit points are known in closed form.
+2. Its refusals: an origin outside the hull, a demand at the origin.
+3. The three outcomes of ``export_demand_state_plots`` -- state at the
+   demand, state at the boundary, nothing -- each with its files and
+   its message, and the ``"none"`` path driven by stubs so that it is
+   exercised deliberately and not by luck of a section.
+4. End to end through ``gensec.cli``: the original failing configuration
+   now writes one ``state_*`` per selected demand.
+"""
+import os
+
+import numpy as np
+import pytest
+import yaml
+
+from gensec.io_yaml import load_yaml
+from gensec.output.state_plots import export_demand_state_plots
+from gensec.output.summary import select_demands_for_fiber_details
+from gensec.solver import FiberSolver, NMDiagram
+from gensec.solver.check import DomainChecker, VerificationEngine
+
+
+# ----------------------------------------------------------------------
+#  Closed-form hulls
+# ----------------------------------------------------------------------
+
+def _box(n_lo, n_hi, mx, my):
+    """Corners of the box ``[n_lo, n_hi] x [-mx, mx] x [-my, my]``."""
+    pts = [(n, sx * mx, sy * my)
+           for n in (n_lo, n_hi) for sx in (-1, 1) for sy in (-1, 1)]
+    a = np.array(pts, dtype=float)
+    return {"N": a[:, 0], "Mx": a[:, 1], "My": a[:, 2]}
+
+
+def test_boundary_point_is_the_exit_of_the_ray_3d():
+    """
+    On a box the exit point of a ray is known: the first bound reached.
+
+    Demand ``(-2000, 50, 25)`` reaches ``N = -1000`` at half its length,
+    long before ``Mx`` (25 of 100) or ``My`` (12.5 of 50), so
+    ``R = (-1000, 25, 12.5)`` and ``eta = 2``.  The normalisation is a
+    diagonal map fixing the origin; if the raw-coordinate relation
+    ``R = T / eta`` were wrong for it, this is where it would show.
+    """
+    dom = DomainChecker(_box(-1000.0, 300.0, 100.0, 50.0))
+    bp = dom.boundary_point_along_ray(-2000.0, 50.0, 25.0)
+    assert bp["eta"] == pytest.approx(2.0, rel=1e-9)
+    assert bp["N"] == pytest.approx(-1000.0, rel=1e-9)
+    assert bp["Mx"] == pytest.approx(25.0, rel=1e-9)
+    assert bp["My"] == pytest.approx(12.5, rel=1e-9)
+    # ... and it is a boundary point: just inside it is inside, just
+    # beyond it is outside.
+    R = np.array([bp["N"], bp["Mx"], bp["My"]])
+    assert dom.is_inside(*(R * (1.0 - 1e-6)))
+    assert not dom.is_inside(*(R * (1.0 + 1e-6)))
+
+
+def test_boundary_point_of_an_inside_demand_lies_beyond_it():
+    """A demand inside the hull has ``eta < 1`` and ``R`` beyond it."""
+    dom = DomainChecker(_box(-1000.0, 300.0, 100.0, 50.0))
+    bp = dom.boundary_point_along_ray(-500.0, 0.0, 0.0)
+    assert bp["eta"] == pytest.approx(0.5, rel=1e-9)
+    assert bp["N"] == pytest.approx(-1000.0, rel=1e-9)
+
+
+def test_boundary_point_2d_hull_passes_my_through_unchanged():
+    """
+    A 2-D hull knows nothing about ``My``; it is returned as given.
+
+    Rescaling it would invent a boundary in a coordinate the domain
+    does not describe.
+    """
+    n = np.array([-1000.0, -1000.0, 300.0, 300.0])
+    m = np.array([-100.0, 100.0, -100.0, 100.0])
+    dom = DomainChecker({"N": n, "M": m})
+    bp = dom.boundary_point_along_ray(-2000.0, 50.0, 7.0)
+    assert bp["eta"] == pytest.approx(2.0, rel=1e-9)
+    assert bp["My"] == 7.0
+
+
+def test_origin_outside_the_hull_is_refused():
+    """
+    With the origin outside, the nearest crossing is not the exit.
+
+    ``_ray_eta`` returns the nearest positive crossing; from outside
+    that is the *entry*.  The method must say so, not return it.
+    """
+    dom = DomainChecker(_box(100.0, 300.0, 100.0, 50.0))
+    with pytest.raises(ValueError, match="origin is not inside"):
+        dom.boundary_point_along_ray(200.0, 10.0, 5.0)
+
+
+def test_demand_at_the_origin_is_refused():
+    """The direction of the ray is undefined; no point is invented."""
+    dom = DomainChecker(_box(-1000.0, 300.0, 100.0, 50.0))
+    with pytest.raises(ValueError, match="coincides with the origin"):
+        dom.boundary_point_along_ray(0.0, 0.0, 0.0)
+
