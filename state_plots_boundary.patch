+def _demands(n_bad):
+    """One demand well inside, then ``n_bad`` far outside the domain."""
+    out = [{"name": "OK", "N_kN": -500, "Mx_kNm": 20, "My_kNm": 0}]
+    out += [{"name": f"BAD{i}", "N_kN": 50,
+             "Mx_kNm": 400 + 20 * i, "My_kNm": 0} for i in range(n_bad)]
+    return out
+
+
+def _write_doc(tmp_path, n_bad):
+    doc = dict(_DOC)
+    doc["demands"] = _demands(n_bad)
+    p = tmp_path / "in.yaml"
+    p.write_text(yaml.safe_dump(doc, sort_keys=False), encoding="utf-8")
+    return str(p)
+
+
+@pytest.fixture(scope="module")
+def rig(tmp_path_factory):
+    """Section, solver, hull and parsed demands for ``OK`` + 5 ``BAD``."""
+    d = tmp_path_factory.mktemp("rig")
+    data = load_yaml(_write_doc(d, 5))
+    section = data["section"]
+    solver = FiberSolver(section)
+    gen = NMDiagram(solver)
+    nm = gen.generate(n_points=30)
+    eng = VerificationEngine(nm, gen, data.get("output_options", {}),
+                             n_points=30)
+    results = eng.check_demands(data["demands"])
+    return section, solver, eng.domain, data["demands"], results
+
+
+def _files(outdir, prefix):
+    return sorted(f for f in os.listdir(outdir) if f.startswith(prefix))
+
+
+def test_premise_the_bad_demands_have_no_equilibrium_state(rig):
+    """
+    The premise the whole patch stands on, measured and not assumed.
+
+    ``BAD*`` are outside the hull *and* the solver does not converge on
+    them; ``OK`` is inside and converges.  If this ever fails, the
+    outcome tests below prove nothing about the defect.
+    """
+    _, solver, dom, demands, _ = rig
+    for d in demands:
+        sol = solver.solve_equilibrium(d["N"], d["Mx"], d["My"])
+        if d["name"] == "OK":
+            assert sol["converged"] and dom.is_inside(d["N"], d["Mx"],
+                                                      d["My"])
+        else:
+            assert (not sol["converged"]
+                    and not dom.is_inside(d["N"], d["Mx"], d["My"]))
+
+
+def test_every_selected_demand_gets_an_outcome_and_an_image(rig, tmp_path):
+    """
+    The original failing configuration: ``top_k = 5`` is all ``BAD``.
+
+    Selected are the five worst, all without a state at the demand.
+    Before: zero ``state_*.png``.  Now: five ``state_*_boundary.png``,
+    five records of kind ``"boundary"`` carrying ``eta_ray > 1``.
+    """
+    section, solver, dom, demands, results = rig
+    names = set(select_demands_for_fiber_details(results, top_k=5))
+    assert names == {f"BAD{i}" for i in range(5)}, (
+        "the fixture no longer reproduces the selection that starved "
+        "the plots")
+    recs = export_demand_state_plots(section, solver, dom, demands,
+                                     names, str(tmp_path))
+    assert [r["kind"] for r in recs] == ["boundary"] * 5
+    assert all(r["eta_ray"] > 1.0 for r in recs)
+    assert len(_files(tmp_path, "state_")) == 5
+    assert all(f.endswith("_boundary.png")
+               for f in _files(tmp_path, "state_"))
+    # the message says why the demand itself was not plotted
+    assert all("no equilibrium state at the demand" in r["message"]
+               for r in recs)
+
+
+def test_a_demand_with_a_state_keeps_the_old_names(rig, tmp_path):
+    """The verified demand is written exactly as before: no suffix."""
+    section, solver, dom, demands, _ = rig
+    recs = export_demand_state_plots(section, solver, dom, demands,
+                                     {"OK"}, str(tmp_path))
+    assert [(r["name"], r["kind"]) for r in recs] == [("OK", "demand")]
+    assert _files(tmp_path, "state_") == ["state_OK.png"]
+    assert _files(tmp_path, "section_") == ["section_OK.png"]
+    assert _files(tmp_path, "fibers_") == ["fibers_OK.csv"]
+
+
+def test_mixed_selection_yields_both_kinds(rig, tmp_path):
+    """One demand at, one beyond: distinct files, distinct kinds."""
+    section, solver, dom, demands, _ = rig
+    recs = export_demand_state_plots(section, solver, dom, demands,
+                                     {"OK", "BAD0"}, str(tmp_path))
+    assert {r["name"]: r["kind"] for r in recs} == {
+        "OK": "demand", "BAD0": "boundary"}
+    assert _files(tmp_path, "state_") == ["state_BAD0_boundary.png",
+                                          "state_OK.png"]
