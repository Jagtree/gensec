+def test_cli_writes_a_state_image_for_the_configuration_that_wrote_none(
+        tmp_path):
+    """
+    ``gensec run`` on one verified demand and five outside the domain.
+
+    The configuration measured to produce zero ``state_*.png``.  With
+    the default ``fiber_details_top_k = 5`` the selection is the five
+    outside demands; each now yields a ``_boundary`` state.
+    """
+    from gensec import cli
+    out = tmp_path / "out"
+    cli.main(["run", _write_doc(tmp_path, 5),
+              "--output-dir", str(out), "--n-points", "30"])
+    states = _files(out, "state_")
+    assert len(states) == 5, states
+    assert all(s.endswith("_boundary.png") for s in states)
